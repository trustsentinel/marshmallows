# Builds the Go binaries (mm-broker, mm-agent, mm-auth) into one small image.
FROM golang:1.27-alpine AS build
ENV GOTOOLCHAIN=auto
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -o /out/ ./cmd/mm-broker ./cmd/mm-agent ./cmd/mm-auth

FROM alpine:3.24
RUN apk add --no-cache ca-certificates
COPY --from=build /out/ /usr/local/bin/
